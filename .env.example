# Copy to .env and fill in. .env is gitignored. Never commit real values.
# From Google Cloud Console > APIs & Services > Credentials > your OAuth 2.0 Client (type: Web application)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that client.
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8765/callback
# Your IANA timezone, used to decide which "night" a reading belongs to.
SLEEPLAB_TZ=America/Los_Angeles
